# ============================================================
# LoCap — Environment variables (copy to .env and fill in)
# Never commit real secrets.
# ============================================================

# --- App ---
NODE_ENV=development
APP_URL=http://localhost:3000
# --- Database (current Prisma schema uses SQLite) ---
DATABASE_URL=file:./dev.db
# Authentication currently uses a local demo user, not password/OAuth login.

# --- Object storage (S3-compatible, MinIO local) ---
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=clipx
S3_SECRET_KEY=clipxsecret
S3_BUCKET=clipx
# Use path-style addressing for MinIO; false for AWS
S3_FORCE_PATH_STYLE=true
S3_PUBLIC_URL=http://localhost:9000/clipx

# --- Speech transcription (required for captions from uploaded audio) ---
# Local/offline: install packages/ai/scripts/requirements-local.txt in .venv-whisper,
# then run infra/scripts/setup-local-transcription.ps1 once to download the default model.
TRANSCRIPTION_PROVIDER=local
LOCAL_TRANSCRIPTION_MODEL=dropbox-dash/faster-whisper-large-v3-turbo
LOCAL_TRANSCRIPTION_DEVICE=cpu
# After setup-local-transcription.ps1 -WithAlignment, use whisperx.
# Native keeps the smaller ASR-only installation available for comparison.
LOCAL_TRANSCRIPTION_ALIGNMENT=native
LOCAL_ALIGNMENT_MODEL_EN=facebook/wav2vec2-base-960h
LOCAL_ALIGNMENT_MODEL_HI=theainerd/Wav2Vec2-large-xlsr-hindi
ASR_AUDIO_PREPROCESS=true
# LOCAL_TRANSCRIPTION_MODEL can also be a local CTranslate2 model directory.
# Optional override; otherwise uses .venv-whisper's Python automatically.
LOCAL_TRANSCRIPTION_PYTHON=
# OpenAI-compatible transcription/whisper endpoint
TRANSCRIPTION_API_KEY=
TRANSCRIPTION_BASE_URL=https://api.openai.com/v1
TRANSCRIPTION_MODEL=whisper-1
# For cloud transcription instead, set TRANSCRIPTION_PROVIDER=api and add a key.
# Synthetic transcription is available only in automated tests.
# LLM provider for clip detection / hooks / titles / rewrite
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini
# Hinglish caption conversion runs locally with Ollama when selected; it does not use AI_API_KEY.
AI_PROVIDER=ollama
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3.5:9b

# --- FFmpeg ---
# Path to ffmpeg/ffprobe binaries (defaults to `ffmpeg`/`ffprobe` on PATH)
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
# GPU acceleration hint (auto | none | nvenc | qsv | vaapi)
FFMPEG_HWACCEL=auto

